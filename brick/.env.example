# Brick bot — local configuration
# Copy this file to `.env` and fill in your own values. NEVER commit the real
# `.env` (it is git-ignored).

# Required — your OpenRouter API key. No default; boot fails fast if missing.
OPENROUTER_API_KEY=

# Optional — OpenRouter (or proxy/self-hosted) API base URL.
# Defaults to https://openrouter.ai/api/v1 if unset.
OPENROUTER_BASE_URL=

# Optional — model name to use for queries. Defaults to the provider default
# (e.g. openai/gpt-4o-mini) if unset.
BRICK_MODEL=

# --- Deployed Discord surface (server.js) only. Optional for the local CLI. ---

# Required for the Discord bot — your application's PUBLIC key (from the Discord
# Developer Portal > General Information). Used to verify interaction signatures.
# The server aborts at boot if this is missing.
DISCORD_PUBLIC_KEY=

# Optional — Jira API token. Unused by the core v1 (Discord→OpenRouter only).
# Set it later if/when you add the Discord↔Jira bridge.
JIRA_API_TOKEN=

# Port the server listens on. Render injects PORT automatically.
PORT=3000
