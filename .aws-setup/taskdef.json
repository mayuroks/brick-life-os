{
  "family": "discord-agent",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::243746944554:role/ecs-task-execution",
  "containerDefinitions": [
    {
      "name": "discord-agent",
      "image": "243746944554.dkr.ecr.us-east-1.amazonaws.com/discord-agent:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DISABLE_VOICE", "value": "1" },
        { "name": "PORT", "value": "3000" },
        { "name": "AGENT_MODEL", "value": "openrouter/deepseek/deepseek-v4-flash-0731" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/discord-agent",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "discord-agent"
        }
      }
    }
  ]
}
