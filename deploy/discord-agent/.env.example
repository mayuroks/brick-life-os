# Life OS agent on Discord — configuration
# Copy this file to `.env` and fill in your own values. NEVER commit the real
# `.env` (it is git-ignored).

# --- Discord ---
# Required. Bot token from the Discord Developer Portal (Bot > Token).
# The bot must have the MESSAGE_CONTENT privileged intent and be in your server.
DISCORD_BOT_TOKEN=

# --- Jira (through the atlassian MCP used by the agent) ---
# Required. The agent reads/writes Jira project data via the Jira MCP.
JIRA_URL=https://mayurzenith.atlassian.net
JIRA_USERNAME=
JIRA_API_TOKEN=

# --- Agent LLM provider ---
# Required. The key opencode uses to run the agent (OpenRouter).
# Example: OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY=

# Optional. Agent model, changeable on the fly (injected into opencode.json at boot).
# Default: openrouter/deepseek/deepseek-v4-flash-0731
# AGENT_MODEL=openrouter/deepseek/deepseek-v4-flash-0731

# --- Optional ---
# HTTP port for the /health endpoint.
PORT=3000
# Address the headless opencode serve listens on (used by the bridge).
OPENCODE_SERVE_URL=http://127.0.0.1:4096
