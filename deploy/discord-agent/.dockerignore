# Keep the deploy image lean and secret-free.
node_modules/
.git
.env
.env.local
*.pem
agent/opencode.json
agent/auth.json
specs/
deploy/discord-agent/.gitignore
*.log
.DS_Store

# Source local model tree — the model is downloaded INSIDE the Docker build, not copied.
models/

# Personal voice recordings — never bake into the image.
fixtures/*.voice.opus
fixtures/**/*.wav
fixtures/**/*.m4a
